{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jorgetbruno/UEtoO3DE/schema/manifest.schema.json",
  "title": "UEtoO3DE level manifest",
  "description": "The interchange contract between the UE exporter and the O3DE importer (plan v2.2, global constraint 7). All lengths are meters and all coordinates are already in O3DE space: the importer must never rescale or re-handed anything.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "level",
    "units",
    "assets",
    "entities",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "description": "Bumped whenever a change would break an existing importer. 2 (M2) added assets[].fbx_node_name and units.lane_b_rule; 3 (M4) added material_data and the texture asset kind; 4 (M6) added entities[].environment; 5 (M4 slot fidelity) added assets[].material_slot_material_names; 6 (M8) added the skeletal_mesh/animation asset kinds, entities[].skeletal and units.lane_b_skeletal_rule; 7 (M9) added the decal/camera entity kinds and blocks.",
      "type": "integer",
      "const": 7
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "engine",
        "engine_version"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "engine_version": {
          "type": "string"
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ue_package",
        "name"
      ],
      "properties": {
        "ue_package": {
          "type": "string",
          "pattern": "^/"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "units": {
      "description": "Declared so an importer can refuse a manifest produced under a different convention rather than silently importing a mirrored level.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length",
        "angle",
        "coordinate_system",
        "lane_a_rule",
        "lane_b_rule",
        "lane_b_skeletal_rule"
      ],
      "properties": {
        "length": {
          "type": "string",
          "const": "meters"
        },
        "angle": {
          "type": "string",
          "const": "degrees"
        },
        "coordinate_system": {
          "type": "string",
          "const": "o3de_right_handed_z_up"
        },
        "lane_a_rule": {
          "type": "string",
          "const": "negate_y"
        },
        "lane_b_rule": {
          "description": "How the referenced geometry ends up reflected in the O3DE product. The exporter bakes diag(-1,-1,1), UE's FBX writer negates Y, and SceneAPI applies a 180-degree yaw diag(-1,-1,1) (a proper rotation -- importers rotate into a declared frame, they never mirror), netting Lane A's diag(1,-1,1); SceneAPI also converts cm to m from the FBX UnitScaleFactor. Measured at the product-buffer level on BOTH asymmetric axes (Lane B correction #3).",
          "type": "string",
          "const": "negate_y_scene_rz180"
        },
        "lane_b_skeletal_rule": {
          "description": "Lane B for SKELETAL sources (M8): no bake stage exists (a GeometryScript mirror destroys skinning), so the product carries LaneA * Rz180 and the importer composes a local Rz180 into every skeletal entity's rotation. Measured at the skinned azmodel buffer level (Y negated vs FBX, Z kept, cm->m).",
          "type": "string",
          "const": "native_y_scene_rz180_entity_rz180"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/asset"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entity"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/warning"
      }
    }
  },
  "definitions": {
    "guid": {
      "description": "UUIDv5 over the UE package path in the project namespace.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quat": {
      "description": "xyzw, canonicalized to w >= 0.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "translation",
        "rotation",
        "scale"
      ],
      "properties": {
        "translation": {
          "$ref": "#/definitions/vec3"
        },
        "rotation": {
          "$ref": "#/definitions/quat"
        },
        "scale": {
          "description": "Every component is positive: handedness is corrected in the rotation, never by mirroring a scale axis (plan constraint 6).",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "box",
            "sphere",
            "capsule",
            "convex"
          ]
        },
        "half_extents": {
          "$ref": "#/definitions/vec3"
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "segment_height": {
          "type": "number",
          "minimum": 0
        },
        "total_height": {
          "type": "number",
          "minimum": 0
        },
        "offset": {
          "$ref": "#/definitions/vec3"
        },
        "rotation": {
          "$ref": "#/definitions/quat"
        },
        "vertex_count": {
          "type": "integer",
          "minimum": 0
        },
        "aabb_min": {
          "$ref": "#/definitions/vec3"
        },
        "aabb_max": {
          "$ref": "#/definitions/vec3"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guid",
        "kind",
        "ue_path",
        "name",
        "o3de_relative_path"
      ],
      "properties": {
        "guid": {
          "$ref": "#/definitions/guid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "static_mesh",
            "material",
            "texture",
            "skeletal_mesh",
            "animation"
          ]
        },
        "ue_path": {
          "type": "string",
          "pattern": "^/"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "o3de_relative_path": {
          "description": "Deterministically sanitized: lowercase, restricted character set, rooted at the importer prefix.",
          "type": "string",
          "pattern": "^uetoo3de/[a-z0-9_./-]+$"
        },
        "fbx_node_name": {
          "description": "Mesh node name inside the exported FBX; the importer's .assetinfo references RootNode.<this>. Static meshes only.",
          "type": "string",
          "minLength": 1
        },
        "bounds_local": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/definitions/vec3"
            },
            "max": {
              "$ref": "#/definitions/vec3"
            }
          }
        },
        "collision": {
          "description": "UE simple collision read from the mesh asset's BodySetup, not from the actor (plan M3).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "shapes"
          ],
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "simple",
                "none"
              ]
            },
            "shapes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/shape"
              }
            }
          }
        },
        "material_slot_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "srgb": {
          "description": "Texture assets: whether UE authored the texture as sRGB. The exported filename's role suffix makes the Atom image builder apply the matching preset.",
          "type": "boolean"
        },
        "role": {
          "description": "Texture assets: basecolor|normal|roughness|metallic|ao|opacity \u2014 chooses the filemask suffix and thus the image preset.",
          "type": "string",
          "enum": [
            "basecolor",
            "normal",
            "roughness",
            "metallic",
            "ao",
            "opacity"
          ]
        },
        "channel": {
          "description": "Texture assets: source channel extracted at export (ORM split); null when the full image is used.",
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "R",
            "G",
            "B",
            "A",
            null
          ]
        },
        "material_data": {
          "$ref": "#/definitions/material_data"
        },
        "material_slot_material_names": {
          "description": "Per slot, the name of the MESH ASSET's own material -- what the baked FBX carries and therefore what the azmodel's slot label is. Distinct from the entity's effective material, which a component override can change (plan M4 slot fidelity).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bone_count": {
          "description": "Skeletal meshes: joints in the skeleton, from SkinnedMeshComponent.get_num_bones (M8). The .actor product must carry the same skeleton.",
          "type": "integer",
          "minimum": 1
        },
        "bone_names": {
          "description": "Skeletal meshes: every joint name, in component bone order. The M8 artifact test asserts each appears in the .actor product bytes.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "skeleton_ue_path": {
          "description": "Skeletal meshes: the UE Skeleton asset package path (informational).",
          "type": "string"
        },
        "duration_seconds": {
          "description": "Animations: AnimSequence play length.",
          "type": "number",
          "minimum": 0
        },
        "root_motion": {
          "description": "Animations: UE enable_root_motion. True is reported as ANIM_ROOT_MOTION_DROPPED at the referencing entity; the motion plays in place.",
          "type": "boolean"
        }
      }
    },
    "material_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "slot_name",
        "material_guid"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "slot_name": {
          "type": "string"
        },
        "material_guid": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_guid",
        "material_slots"
      ],
      "properties": {
        "asset_guid": {
          "$ref": "#/definitions/guid"
        },
        "material_slots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/material_slot"
          }
        }
      }
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "intensity",
        "intensity_units",
        "color_srgb8",
        "color_linear",
        "cast_shadows"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "point",
            "spot",
            "directional",
            "unknown"
          ]
        },
        "intensity": {
          "type": "number"
        },
        "intensity_units": {
          "description": "UE5 carries a units enum per light; a directional light has none and is always lux (plan M5).",
          "type": "string",
          "enum": [
            "candelas",
            "lumens",
            "ev",
            "nits",
            "unitless",
            "lux"
          ]
        },
        "color_srgb8": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "color_linear": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "cast_shadows": {
          "type": "boolean"
        },
        "temperature_k": {
          "type": "number"
        },
        "use_temperature": {
          "type": "boolean"
        },
        "attenuation_radius": {
          "type": "number",
          "minimum": 0
        },
        "source_radius": {
          "type": "number",
          "minimum": 0
        },
        "inner_cone_angle_deg": {
          "type": "number"
        },
        "outer_cone_angle_deg": {
          "type": "number"
        }
      }
    },
    "physics": {
      "description": "Present only when the actor actually collides; absent means render-only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_collision",
        "collision_enabled",
        "collision_profile",
        "simulates_physics",
        "kinematic",
        "is_trigger",
        "shapes",
        "shapes_from_asset"
      ],
      "properties": {
        "has_collision": {
          "type": "boolean"
        },
        "collision_enabled": {
          "type": "string",
          "enum": [
            "no_collision",
            "query_only",
            "physics_only",
            "query_and_physics",
            "probe_only",
            "query_and_probe",
            "unknown"
          ]
        },
        "collision_profile": {
          "type": "string"
        },
        "simulates_physics": {
          "type": "boolean"
        },
        "kinematic": {
          "type": "boolean"
        },
        "is_trigger": {
          "type": "boolean"
        },
        "generate_overlap_events": {
          "type": "boolean"
        },
        "enable_gravity": {
          "type": "boolean"
        },
        "ccd": {
          "type": "boolean"
        },
        "linear_damping": {
          "type": "number"
        },
        "angular_damping": {
          "type": "number"
        },
        "mass_override": {
          "type": "boolean"
        },
        "mass_kg": {
          "type": [
            "number",
            "null"
          ]
        },
        "shapes": {
          "description": "Actor-owned shapes (trigger volumes). Mesh actors borrow theirs from the asset named by shapes_from_asset.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/shape"
          }
        },
        "shapes_from_asset": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "ue_class",
        "ue_actor_path",
        "kind",
        "parent_id",
        "mobility",
        "transform"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/guid"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ue_class": {
          "type": "string",
          "minLength": 1
        },
        "ue_actor_path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "static_mesh",
            "skeletal_mesh",
            "decal",
            "camera",
            "light",
            "trigger",
            "environment",
            "unknown"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mobility": {
          "type": "string",
          "enum": [
            "static",
            "stationary",
            "movable"
          ]
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "world",
            "local"
          ],
          "properties": {
            "world": {
              "$ref": "#/definitions/transform"
            },
            "local": {
              "$ref": "#/definitions/transform"
            }
          }
        },
        "mesh": {
          "$ref": "#/definitions/mesh"
        },
        "skeletal": {
          "$ref": "#/definitions/skeletal"
        },
        "decal": {
          "$ref": "#/definitions/decal"
        },
        "camera": {
          "$ref": "#/definitions/camera"
        },
        "light": {
          "$ref": "#/definitions/light"
        },
        "physics": {
          "$ref": "#/definitions/physics"
        },
        "environment": {
          "$ref": "#/definitions/environment"
        }
      }
    },
    "decal": {
      "description": "A decal entity (M9): Atom Decal component. UE projects along local +X with decal_size half-extents (x = projection depth); the importer owns the axis remap onto Atom's projection. The material converts through the StandardPBR subset (DECAL_MATERIAL_APPROX).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_guid",
        "half_extents_m",
        "sort_order"
      ],
      "properties": {
        "material_guid": {
          "type": [
            "string",
            "null"
          ]
        },
        "half_extents_m": {
          "$ref": "#/definitions/vec3"
        },
        "sort_order": {
          "type": "integer"
        },
        "fade_screen_size": {
          "type": "number"
        }
      }
    },
    "camera": {
      "description": "A camera entity (M9): O3DE Camera component. UE field_of_view is HORIZONTAL degrees; O3DE takes VERTICAL -- both the number and the aspect ratio the conversion needs are carried so the arithmetic is testable offline. Orthographic cameras are dropped (CAMERA_UNSUPPORTED_MODE).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fov_horizontal_deg",
        "aspect_ratio"
      ],
      "properties": {
        "fov_horizontal_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 179
        },
        "aspect_ratio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "constrain_aspect_ratio": {
          "type": "boolean"
        }
      }
    },
    "skeletal": {
      "description": "A skeletal-mesh entity (M8): Actor component from the skeletal_mesh asset's .actor product, plus a Simple Motion component when an animation is assigned (UE single-node playback). An AnimBlueprint-driven component carries no animation_guid and imports in bind pose.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_guid",
        "animation_guid",
        "loop",
        "play",
        "material_slots"
      ],
      "properties": {
        "asset_guid": {
          "$ref": "#/definitions/guid"
        },
        "animation_guid": {
          "type": [
            "string",
            "null"
          ]
        },
        "loop": {
          "type": "boolean"
        },
        "play": {
          "type": "boolean"
        },
        "material_slots": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/material_slot"
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "subject",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "subject": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "material_property_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "texture",
            "scalar",
            "color"
          ]
        },
        "texture_guid": {
          "type": "string"
        },
        "channel": {
          "type": [
            "string",
            "null"
          ]
        },
        "factor": {},
        "value": {}
      }
    },
    "material_data": {
      "description": "The recognized subset of a UE material graph (M4). null = base colour unmappable; entities keep the default material.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "blend_mode",
        "two_sided",
        "properties"
      ],
      "properties": {
        "blend_mode": {
          "type": "string",
          "enum": [
            "opaque",
            "masked",
            "translucent"
          ]
        },
        "two_sided": {
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_color": {
              "$ref": "#/definitions/material_property_spec"
            },
            "normal": {
              "$ref": "#/definitions/material_property_spec"
            },
            "roughness": {
              "$ref": "#/definitions/material_property_spec"
            },
            "metallic": {
              "$ref": "#/definitions/material_property_spec"
            },
            "occlusion": {
              "$ref": "#/definitions/material_property_spec"
            },
            "opacity": {
              "$ref": "#/definitions/material_property_spec"
            },
            "opacity_mask": {
              "$ref": "#/definitions/material_property_spec"
            }
          }
        }
      }
    },
    "environment": {
      "description": "Environment actor payload (plan M6): sky, skylight, fog, post-process and reflection capture. Only values the UE artist actually authored are carried -- a PostProcessVolume setting is present only when its override_* flag is set, so the importer never mistakes a UE default for an intent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "skylight",
            "fog",
            "post_process",
            "sky_atmosphere",
            "reflection_capture",
            "unknown"
          ]
        },
        "intensity": {
          "type": "number"
        },
        "color_linear": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "real_time_capture": {
          "type": "boolean"
        },
        "source_type": {
          "description": "UE SkyLightSourceType; a specified cubemap is an asset reference, a captured scene is not exportable in v1.",
          "type": "string",
          "enum": [
            "captured_scene",
            "specified_cubemap",
            "unknown"
          ]
        },
        "cubemap_ue_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "lower_hemisphere_is_black": {
          "type": "boolean"
        },
        "fog_density": {
          "type": "number"
        },
        "fog_height_falloff": {
          "type": "number"
        },
        "fog_inscattering_color_linear": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "start_distance": {
          "description": "metres (Lane A converted)",
          "type": "number"
        },
        "fog_cutoff_distance": {
