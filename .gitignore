# --- Unreal Engine ---
UE/**/Binaries/
UE/**/Intermediate/
UE/**/Saved/
UE/**/DerivedDataCache/
UE/Build/

# --- O3DE ---
O3DE/**/build/
O3DE/**/Cache/
O3DE/**/user/
O3DE/**/log/

# --- Python ---
__pycache__/
*.pyc

# --- Test results ---
Tests/**/results/

# --- Machine-specific paths ---
# Tests/paths.config holds one developer's engine and project locations.
# Tests/paths.config.template is committed; the copy never is. Committing it
# is how this repo ended up with 40 files hardcoding one machine's drive
# letters, which nobody else could run.
Tests/paths.config

# --- Generated interchange output ---
# NOTHING under Exports/ is committed except Exports/LaneB/ (S0.2 measurement
# evidence cited by LANE_B.md, derived from our own fixture mesh). Everything
# else is regenerated by the pipeline -- and exports of real levels contain
# geometry and textures from LICENSED third-party asset packs, which must
# never enter this repository or its history.
Exports/*
!Exports/LaneB/

ue-to-o3de-milestone-plan-v2.md
